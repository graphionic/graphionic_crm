# ============================================================
#  ClientForge CRM — environment variables
#  Copy to .env and fill in. NEVER commit .env
# ============================================================

# ---- Database (Neon / Supabase / any Postgres) --------------
# Use the POOLED connection string on Vercel (serverless needs it).
# Neon pooled strings end with:  ?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Direct (non-pooled) URL — used by `prisma db push` / migrations
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# ---- Auth ---------------------------------------------------
# 32+ random chars. Generate: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"

# First admin, created by `npm run seed`
ADMIN_EMAIL="you@yourdomain.com"
ADMIN_PASSWORD="ChangeThisNow123!"
ADMIN_NAME="Your Name"

# ---- Secrets encryption -------------------------------------
# Encrypts SMTP passwords / API tokens stored in the database.
# 32 bytes, base64. Generate: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY="change-me-32-byte-base64-key"

# ---- Collector Credentials encryption (Phase 4A) ------------
# Encrypts provider API keys (OpenAI, Map APIs, enrichment) at rest.
# MUST be 32 bytes base64. Generate: openssl rand -base64 32
# Do NOT commit production key. Set in Vercel env vars.
# If not set, falls back to SETTINGS_ENCRYPTION_KEY for dev.
CREDENTIAL_ENCRYPTION_KEY="change-me-32-byte-base64-key-for-collector"

# ---- App ----------------------------------------------------
NEXT_PUBLIC_APP_NAME="ClientForge CRM"
# Set to your Vercel URL in production, e.g. https://crm.yourdomain.com
APP_URL="http://localhost:3000"

# ---- Optional: analytics / error tracking -------------------
# SENTRY_DSN=""

# ---- Google Places API (Phase 4C.4C) ------------------------
# Canonical production env var for Google Maps/Places API key
# Never commit real key. Set in GitHub Secrets and/or local .env (gitignored)
# Future injection: GitHub Actions will use ${{ secrets.GOOGLE_MAPS_API_KEY }}
# Vercel does NOT need this unless server-side CRM requires Google network (least privilege)
GOOGLE_MAPS_API_KEY=

