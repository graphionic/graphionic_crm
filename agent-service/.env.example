# ============================================================
#  HIMI — ClientForge AI Agent Environment Variables
#  Copy to .env for standalone local execution.
#  NEVER commit real credentials.
# ============================================================

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT=45
OPENAI_AGENT_SDK_HOST=127.0.0.1
OPENAI_AGENT_SDK_PORT=8787

# PostgreSQL database URL (Prisma)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# MCP Server Configuration
MCP_ENABLED=false
MCP_ACCESS_TOKEN=
MCP_ALLOWED_ORIGINS=
MCP_RATE_LIMIT_PER_MINUTE=60
