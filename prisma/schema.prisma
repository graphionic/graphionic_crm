// Prisma schema — ClientForge CRM
// Postgres. Works on Neon / Supabase / any managed Postgres free tier.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- auth
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------------------------------------------------------------- leads
model Lead {
  id String @id @default(cuid())

  // company
  companyName      String
  businessCategory String? // "Dental Clinic", "Plumber", "Marketing Agency"
  industry         String?
  country          String  @default("UK") // UK | USA | UAE | AU | CA | other
  city             String?
  region           String?
  address          String?
  postcode         String?
  companyNumber    String? // Companies House / registry number
  companyUrl       String?

  // website analysis (from qualify_leads.py)
  website       String?
  websiteStatus String? // likely | check | unverified | none
  segment       String? // NO_SITE | BROKEN | OUTDATED | OK | UNCHECKED
  score         Int     @default(0)
  issues        String?
  hookLine      String? // the personalised opening line

  // contact person
  contactName String?
  contactRole String?
  email       String?
  phone       String?
  whatsapp    String?
  linkedin    String?

  // pipeline
  source         String? // companies_house | apollo | referral | manual | inbound
  status         String  @default("NEW")
  // NEW | QUALIFIED | CONTACTED | REPLIED | CALL_BOOKED | PROPOSAL_SENT
  // | WON | LOST | NURTURE
  priority       String  @default("MEDIUM") // LOW | MEDIUM | HIGH
  dealValueCents Int? // in USD cents, avoids float issues
  quotedCurrency String? @default("GBP")

  // compliance — set these BEFORE any outreach
  optedInEmail    Boolean @default(false)
  optedInWhatsapp Boolean @default(false)
  doNotContact    Boolean @default(false)

  // counters & dates
  emailSentCount    Int       @default(0)
  whatsappSentCount Int       @default(0)
  lastEmailAt       DateTime?
  lastWhatsappAt    DateTime?
  lastInboundAt     DateTime? // last time THEY contacted us (drives the 24h window)
  lastReplyAt       DateTime?
  nextFollowUpAt    DateTime?

  notes String?
  tags  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]

  // Phase 4C.2A — traceability
  collectorRunId String?
  collectorRun   CollectorRun? @relation(fields: [collectorRunId], references: [id], onDelete: SetNull)

  // Inverse for qualified candidate (one-to-one)
  qualifiedFromCandidate LeadCandidate? @relation("CandidateQualifiedLead")

  @@index([status])
  @@index([country])
  @@index([segment])
  @@index([nextFollowUpAt])
  @@index([companyName])
  @@index([collectorRunId])
}

// ---------------------------------------------------------------- timeline
model Activity {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type         String // EMAIL | WHATSAPP | CALL | NOTE | STATUS | TASK
  direction    String  @default("OUT") // OUT | IN
  channel      String? // smtp | resend | whatsapp | manual
  subject      String?
  body         String?
  templateName String?
  status       String? // queued | sent | delivered | read | failed | received
  externalId   String?
  error        String?
  meta         String? // JSON string for extra data

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
  @@index([type])
}

// ---------------------------------------------------------------- settings
model Setting {
  key       String   @id
  value     String
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- suppression
model Suppression {
  id        String   @id @default(cuid())
  value     String   @unique // email or phone, normalised lowercase
  reason    String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------- templates
model Template {
  id             String   @id @default(cuid())
  name           String
  channel        String // EMAIL | WHATSAPP
  subject        String?
  body           String
  // WhatsApp Cloud API specific
  waTemplateName String?
  waLanguage     String?  @default("en_US")
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------- PHASE 4A — COLLECTOR CONFIGURATION & PERSISTENCE

model CollectorConfig {
  id  String @id @default(cuid())
  key String @unique @default("default")

  enabled        Boolean @default(true)
  collectionMode String  @default("continuous") // continuous | scheduled | manual

  defaultBatchSize           Int @default(25)
  defaultQueryLimit          Int @default(50)
  concurrentRequests         Int @default(15)
  requestTimeoutMs           Int @default(25000)
  retryCount                 Int @default(3)
  cooldownMs                 Int @default(7000)
  collectionFrequencyMinutes Int @default(15)

  verificationEnabled       Boolean @default(true)
  emailRequired             Boolean @default(true)
  websiteFilteringEnabled   Boolean @default(true)
  duplicateFilteringEnabled Boolean @default(true)

  metadata Json? // extensible

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- PHASE 4C.3A — ENRICHMENT ENGINE FOUNDATION

model EnrichmentConfig {
  id  String @id @default(cuid())
  key String @unique @default("default")

  // Critical: default enrichment MUST be disabled
  enabled Boolean @default(false)

  // Budget / rate-limit foundation
  dailyCandidateLimit Int @default(100) // max candidates to enrich per day
  batchSize           Int @default(25) // per-run batch size
  maxAttemptsPerCandidate Int @default(3) // max attempts per candidate
  retryCooldownMinutes    Int @default(60) // cooldown between retries
  jobLockDurationMinutes  Int @default(10) // lock duration for claimed jobs

  providerDailyCreditLimit   Int? // global daily credit limit
  providerMonthlyCreditLimit Int? // global monthly credit limit

  metadata Json? // extensible for future provider-specific config

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EnrichmentJobStatus {
  PENDING
  PROCESSING
  VERIFICATION_PENDING
  COMPLETED
  FAILED
  EXHAUSTED
  CANCELLED
}

enum EnrichmentAttemptStatus {
  STARTED
  SUCCESS
  NO_RESULT
  FAILED
  SKIPPED
}

model CollectorLocation {
  id String @id @default(cuid())

  country     String // United States
  countryCode String // US, UK, AE, AU, IN
  state       String? // Texas, England, Dubai, Victoria, Gujarat
  city        String // Houston, Manchester, Dubai, Melbourne, Surat

  latitude  Float?
  longitude Float?
  radiusKm  Int    @default(25)

  enabled       Boolean @default(true)
  priority      Int     @default(50) // 0-100, higher = more important
  priorityLabel String  @default("MEDIUM") // LOW | MEDIUM | HIGH

  lastCollectedAt DateTime?
  nextCollectAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states CollectorState[]
  runs   CollectorRun[]

  @@index([enabled])
  @@index([priority])
  @@index([countryCode])
  @@index([city])
}

model LeadCategory {
  id String @id @default(cuid())

  name        String // Dental, Eye Clinic, Restaurants
  slug        String  @unique // dental, eye, restaurants
  description String?

  enabled       Boolean @default(true)
  priority      Int     @default(50)
  priorityLabel String  @default("MEDIUM")

  osmTags     Json? // ["healthcare"="dentist", "amenity"="dentist"]
  queryConfig Json? // additional query config
  runLimit    Int? // query limit if applicable

  lastRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states CollectorState[]
  runs   CollectorRun[]

  @@index([enabled])
  @@index([priority])
}

model DataSource {
  id String @id @default(cuid())

  name     String // OpenStreetMap / Overpass
  type     String // overpass | google_places | google_maps | custom
  enabled  Boolean @default(true)
  priority Int     @default(50)

  baseUrl     String // https://overpass-api.de/api/interpreter
  timeoutMs   Int    @default(25000)
  retryCount  Int    @default(3)
  concurrency Int    @default(15)

  config        Json? // extensible JSON for provider-specific config
  healthStatus  String    @default("unknown") // healthy | degraded | down | unknown
  lastCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states     CollectorState[]
  runs       CollectorRun[]
  candidates LeadCandidate[]

  // Phase 4C.4B — Google guardrails
  googleUsages GoogleApiUsage[]
  googleCaches GoogleApiCache[]

  @@index([enabled])
  @@index([type])
}

model ProviderCredential {
  id String @id @default(cuid())

  provider String // openai | google_maps | enrichment | resend | custom | hunter | dropcontact | apollo | snov
  label    String? // optional label for multiple keys per provider

  encryptedValue String // AES-256-GCM encrypted API key, never plaintext
  keyHint        String? // last 4 chars masked like ••••9K2A

  enabled Boolean @default(true)
  status  String  @default("configured") // configured | connected | error | missing

  // Phase 4C.3A — enrichment budget foundation (additive, optional)
  priority     Int  @default(50) // 0-100, higher = preferred provider
  dailyLimit   Int? // max attempts/credits per day
  monthlyLimit Int? // max attempts/credits per month

  lastUsedAt   DateTime?
  lastTestedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations — Phase 4C.3A
  enrichmentAttempts EnrichmentAttempt[]

  @@unique([provider, label])
  @@index([provider])
  @@index([enabled])
}

model CollectionRule {
  id String @id @default(cuid())

  key         String  @unique // require_email, reject_generic, require_no_website, etc
  name        String // Require Email
  description String?
  enabled     Boolean @default(true)
  category    String  @default("lead_requirements") // lead_requirements | verification | deduplication | filtering

  config Json? // extensible rule config

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([category])
}

model CollectorState {
  id String @id @default(cuid())

  locationId String?
  location   CollectorLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  categoryId String?
  category   LeadCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  sourceId String?
  source   DataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  lastRunAt           DateTime?
  lastSuccessfulRunAt DateTime?
  nextEligibleRunAt   DateTime?

  cursor              Json? // progress metadata, bbox offset, page, etc
  cycle               Int   @default(0)
  consecutiveFailures Int   @default(0)

  totalCandidates Int @default(0)
  totalAccepted   Int @default(0)
  totalRejected   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, categoryId, sourceId])
  @@index([nextEligibleRunAt])
}

model CollectorRun {
  id String @id @default(cuid())

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("QUEUED") // QUEUED | RUNNING | SUCCESS | PARTIAL | FAILED

  locationId String?
  location   CollectorLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  categoryId String?
  category   LeadCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  sourceId String?
  source   DataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  queriesAttempted Int @default(0)
  candidatesFound  Int @default(0)

  noEmailRejected      Int @default(0)
  genericEmailRejected Int @default(0)
  websiteRejected      Int @default(0)
  duplicateRejected    Int @default(0)
  invalidRejected      Int @default(0)

  leadsAccepted Int @default(0)
  leadsInserted Int @default(0)

  durationMs   Int?
  errorMessage String?

  metadata Json?

  createdAt DateTime @default(now())

  // Phase 4C.2A — traceability
  leads      Lead[]
  candidates LeadCandidate[] @relation("CandidateDiscoveryRun")

  // Phase 4C.4B — Google guardrails
  googleUsages GoogleApiUsage[]

  @@index([status])
  @@index([startedAt])
  @@index([locationId])
  @@index([categoryId])
}

// ---------------------------------------------------------------- PHASE 4C.2A — LEAD CANDIDATE PERSISTENCE + TRACEABILITY

enum LeadCandidateStatus {
  DISCOVERED
  NEEDS_ENRICHMENT
  VERIFICATION_PENDING
  QUALIFIED
  REJECTED
}

model LeadCandidate {
  id String @id @default(cuid())

  // provider identity — for dedup across providers
  externalId   String? // OSM id (e.g., 123456) or Google place_id
  externalType String? // node | way | relation | google_place

  // business identity
  companyName      String
  businessCategory String

  address  String?
  city     String?
  country  String?
  postcode String?

  latitude  Float?
  longitude Float?

  phone   String?
  email   String?
  website String?

  // discovery traceability
  discoverySourceId String?
  discoverySource   DataSource? @relation(fields: [discoverySourceId], references: [id], onDelete: SetNull)

  discoveryRunId String
  discoveryRun   CollectorRun @relation("CandidateDiscoveryRun", fields: [discoveryRunId], references: [id], onDelete: Cascade)

  // lifecycle
  status          LeadCandidateStatus @default(DISCOVERED)
  rejectionReason String? // existing_website, generic_email, invalid_email, email_domain_has_live_website, duplicate, enrichment_failed

  // future enrichment foundation ONLY (no behavior yet) — legacy counters
  enrichmentAttempts Int       @default(0)
  lastEnrichmentAt   DateTime?
  enrichmentProvider String?

  // qualification
  qualifiedLeadId String? @unique
  qualifiedLead   Lead?   @relation("CandidateQualifiedLead", fields: [qualifiedLeadId], references: [id], onDelete: SetNull)

  rawTags  Json? // full OSM tags or Places raw
  metadata Json? // extensible

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 4C.3A — enrichment relations
  enrichmentJob      EnrichmentJob?
  enrichmentAttemptRecords EnrichmentAttempt[]

  // Composite unique for OSM dedup: same source + externalType + externalId should be unique, but allow nulls and future providers coexistence
  // We use a unique constraint on source + externalType + externalId where externalId not null
  // Prisma does not support partial unique, so we document and enforce via application logic + unique index on combined fields
  @@unique([discoverySourceId, externalType, externalId])
  @@index([status])
  @@index([discoveryRunId])
  @@index([businessCategory])
  @@index([city])
  @@index([qualifiedLeadId])
  @@index([discoverySourceId])
  @@index([externalId])
}

model EnrichmentJob {
  id String @id @default(cuid())

  // Candidate — at most ONE active job per candidate (unique)
  candidateId String @unique
  candidate   LeadCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  status EnrichmentJobStatus @default(PENDING)

  priority Int @default(50) // 0-100, higher = sooner

  attemptCount Int @default(0)
  maxAttempts  Int @default(3)

  nextAttemptAt DateTime?

  // Concurrency protection
  lockedAt      DateTime?
  lockedBy      String? // workerId
  lockExpiresAt DateTime?

  lastAttemptAt DateTime?
  completedAt   DateTime?

  // Staged results (provider-neutral)
  resultEmail   String?
  resultDomain  String?
  resultWebsite String?

  failureReason String?

  metadata Json? // extensible, safe summary only — never secrets

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts EnrichmentAttempt[]

  @@index([status])
  @@index([nextAttemptAt])
  @@index([priority])
  @@index([lockedBy])
  @@index([lockExpiresAt])
  @@index([candidateId])
}

model EnrichmentAttempt {
  id String @id @default(cuid())

  jobId String
  job   EnrichmentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  candidateId String
  candidate   LeadCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // Provider identity — snapshot, never secret
  providerCredentialId String?
  providerCredential   ProviderCredential? @relation(fields: [providerCredentialId], references: [id], onDelete: SetNull)

  providerType String? // hunter | dropcontact | apollo | mock | etc
  providerLabel String? // label snapshot

  status EnrichmentAttemptStatus @default(STARTED)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  // Found data
  emailFound   String?
  domainFound  String?
  websiteFound String?

  failureReason        String?
  providerResponseCode String? // HTTP code or provider-specific code, safe

  costUnits   Float? // credits, cost units
  creditsUsed Float?

  metadata Json? // safe summary only

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([candidateId])
  @@index([providerCredentialId])
  @@index([status])
  @@index([startedAt])
  @@index([providerType])
}

// ---------------------------------------------------------------- PHASE 4C.4B — GOOGLE REQUEST GUARDRAILS

model GoogleCollectionConfig {
  id  String @id @default(cuid())
  key String @unique @default("default")

  enabled    Boolean @default(false) // fail-closed default
  failClosed Boolean @default(true)

  perRunRequestLimit Int @default(10)
  dailyRequestLimit  Int @default(50)
  monthlyRequestLimit Int @default(500)

  dailyCostUnitLimit   Int? // optional architecture, internal cost units, NOT USD
  monthlyCostUnitLimit Int?

  cacheEnabled Boolean @default(true)
  queryCacheTtlHours Int @default(24)
  placeDetailsCacheTtlHours Int @default(168)

  retryLimit Int @default(0) // no retries by default to avoid bypassing budget

  // Phase 4C.4C.5A — Limited Activation Architecture
  activationMode String @default("DISABLED") // DISABLED | CANARY | PRODUCTION — explicit mode, fail closed default

  canaryScopes Json? // [{countryCode, city, categorySlug}] — explicit allowlist, Manchester+dental ONLY initial
  canaryPerRunRequestLimit Int? @default(3) // canary-specific tiny limits
  canaryDailyRequestLimit Int? @default(5)
  canaryMonthlyRequestLimit Int? // optional, defaults to monthly hard cap 500

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GoogleOperation {
  TEXT_SEARCH
  NEARBY_SEARCH
  PLACE_DETAILS
  GEOCODING
}

enum GoogleRequestStatus {
  RESERVED
  SUCCESS
  NO_RESULT
  FAILED
  CANCELLED
}

enum GoogleErrorClassification {
  AUTH_ERROR
  QUOTA_EXCEEDED
  RATE_LIMITED
  SERVER_ERROR
  INVALID_REQUEST
  NETWORK_ERROR
  UNKNOWN
}

model GoogleApiUsage {
  id String @id @default(cuid())

  sourceId String
  source   DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  operation GoogleOperation
  status    GoogleRequestStatus @default(RESERVED)

  reservedAt  DateTime @default(now())
  completedAt DateTime?
  requestSentAt DateTime? // when request actually sent, for CANCELLED semantics

  requestUnits Int @default(1)

  estimatedCostUnits Int? // integer internal cost units, NOT Float, NOT USD
  actualCostUnits    Int?

  collectorRunId String
  collectorRun   CollectorRun @relation(fields: [collectorRunId], references: [id], onDelete: Restrict)

  workerId String?

  queryFingerprint String
  placeId          String?

  errorClassification GoogleErrorClassification?
  errorMessage        String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceId, reservedAt])
  @@index([collectorRunId, reservedAt])
  @@index([status, reservedAt])
  @@index([operation, status, reservedAt])
  @@index([sourceId, queryFingerprint, operation, status])
  @@index([placeId])
  @@index([workerId])
  @@index([queryFingerprint])
}

model GoogleApiCache {
  id String @id @default(cuid())

  sourceId String
  source   DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  queryFingerprint String
  operation        GoogleOperation

  responseMetadata Json?
  expiresAt        DateTime
  placeId          String?

  hitCount  Int @default(0)
  lastHitAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, queryFingerprint, operation]) // source-aware cache uniqueness
  @@index([expiresAt])
  @@index([operation])
  @@index([queryFingerprint])
  @@index([sourceId])
  @@index([placeId])
}
